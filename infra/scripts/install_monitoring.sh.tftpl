#!/bin/bash
# =====================================================================
# Script exécuté par Azure DANS la VM (extension Custom Script).
# Il installe Docker (version figée), dépose les fichiers de la stack de monitoring
# et lance Prometheus + Grafana + node_exporter.
#
# Ce fichier est un MODÈLE Terraform (.tftpl) : les éléments entre
# dollar-accolades sont remplacés par Terraform avant l'envoi à la VM.
# Les fichiers sont transmis encodés en base64 pour éviter tout souci
# de caractères spéciaux.
# =====================================================================
set -euo pipefail

# 1. Installer Docker, dans une VERSION FIGÉE
#    (variable docker_version de Terraform), depuis le dépôt officiel
#    de Docker, dont on vérifie la signature grâce à sa clé GPG.
DOCKER_VERSION="${docker_version}"

if dpkg -s docker.io > /dev/null 2>&1; then
  # Docker a été installé à la main avec le paquet Ubuntu "docker.io" :
  # il est incompatible avec le paquet officiel, on n'y touche donc pas.
  echo "Docker (paquet docker.io) déjà installé à la main : version laissée telle quelle."
else
  # a) Ajouter le dépôt officiel de Docker et sa clé de signature
  apt-get update
  apt-get install -y ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update

  # b) Retrouver le nom exact du paquet pour la version demandée
  #    (par exemple 28.5.1 -> 5:28.5.1-1~ubuntu.22.04~jammy)
  PKG_VERSION=$(apt-cache madison docker-ce | awk '{print $3}' | grep "^5:$DOCKER_VERSION-" | head -n 1 || true)
  if [ -z "$PKG_VERSION" ]; then
    echo "ERREUR : la version de Docker $DOCKER_VERSION n'existe pas. Dernières versions disponibles :"
    apt-cache madison docker-ce | awk '{print $3}' | head -n 15
    exit 1
  fi

  # c) Installer cette version, seulement si ce n'est pas déjà celle-là
  INSTALLED=$(dpkg-query -W -f='$${Version}' docker-ce 2> /dev/null || true)
  if [ "$INSTALLED" != "$PKG_VERSION" ]; then
    apt-mark unhold docker-ce docker-ce-cli > /dev/null 2>&1 || true
    apt-get install -y --allow-downgrades \
      docker-ce="$PKG_VERSION" docker-ce-cli="$PKG_VERSION" \
      containerd.io docker-buildx-plugin docker-compose-plugin
  fi

  # d) "Bloquer" la version : un apt upgrade ne la changera plus.
  #    Pour changer de version, on modifie docker_version dans Terraform.
  apt-mark hold docker-ce docker-ce-cli
fi

echo "Docker installé : $(docker --version)"

# Docker installé à la main via le paquet Ubuntu "docker.io" n'inclut pas
# toujours "docker compose" : on l'ajoute seulement s'il manque.
if ! docker compose version > /dev/null 2>&1; then
  apt-get update
  apt-get install -y docker-compose-v2 || apt-get install -y docker-compose-plugin
fi

# Permet à l'utilisateur admin d'utiliser Docker sans sudo
usermod -aG docker ${admin_username}

# 2. Déposer les fichiers de la stack dans /opt/monitoring-stack
mkdir -p /opt/monitoring-stack/prometheus
mkdir -p /opt/monitoring-stack/grafana/provisioning/datasources
mkdir -p /opt/monitoring-stack/grafana/provisioning/dashboards
mkdir -p /opt/monitoring-stack/grafana/dashboards

echo '${docker_compose_b64}'   | base64 -d > /opt/monitoring-stack/docker-compose.yml
echo '${prometheus_b64}'       | base64 -d > /opt/monitoring-stack/prometheus/prometheus.yml
echo '${datasources_b64}'      | base64 -d > /opt/monitoring-stack/grafana/provisioning/datasources/datasources.yml
echo '${dashboards_conf_b64}'  | base64 -d > /opt/monitoring-stack/grafana/provisioning/dashboards/dashboards.yml
echo '${dashboard_azure_b64}'  | base64 -d > /opt/monitoring-stack/grafana/dashboards/smart-energy-azure.json

# Tableau de bord communautaire "Node Exporter Full" (n°1860 sur grafana.com),
# téléchargé directement par la VM. Il est prévu pour être importé à la main :
# on remplace sa source de données "à choisir" par notre Prometheus (uid "prometheus").
# S'il ne peut pas être téléchargé, on continue quand même.
if curl -fsSL https://grafana.com/api/dashboards/1860/revisions/37/download -o /tmp/node-exporter-full.json; then
  sed -e 's/\$[{]DS_PROMETHEUS[}]/prometheus/g' \
      -e 's/"title": *"Node Exporter Full"/"title": "VM applicative"/' \
      /tmp/node-exporter-full.json > /opt/monitoring-stack/grafana/dashboards/node-exporter-full.json
  else
  echo "Attention : tableau de bord 1860 non téléchargé (à importer à la main)."
fi

# 3. Le fichier .env (mot de passe Grafana + ID d'abonnement),
#    lisible uniquement par root
echo '${env_b64}' | base64 -d > /opt/monitoring-stack/.env
chmod 600 /opt/monitoring-stack/.env

# 4. Lancer (ou mettre à jour) les conteneurs
cd /opt/monitoring-stack
docker compose pull
docker compose up -d

echo "Stack de monitoring démarrée."
